<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Byd.AuthManagement</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Domain.Shared" Version="10.3.0" />
    <PackageReference Include="Volo.Abp.FeatureManagement.Domain.Shared" Version="10.3.0" />
    <PackageReference Include="Volo.Abp.Validation" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\AuthManagement\*.json" />
    <Content Remove="Localization\AuthManagement\*.json" />
    <EmbeddedResource Include="Invitations\Templates\**\*.tpl" />
    <Content Remove="Invitations\Templates\**\*.tpl" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Byd.LogManagement.Domain.Shared" Version="0.1.3" />
  </ItemGroup>

</Project>
